// 资源脚本：把应用清单与应用图标内嵌进 exe。
//
// 清单里声明了 comctl32 v6 —— native-windows-gui 依赖的
// GetWindowSubclass / SetWindowSubclass 只有 v6 版本才导出，
// 缺少清单时程序启动会报「无法定位程序入口点 GetWindowSubclass」。
//
// 图标是新版应用图标（assets/icon-source.jpg 经 scripts/sync_app_icon.py
// 生成）：标题栏、任务栏、托盘、侧边栏 logo、网页 favicon 都用它，
// 保证「同一个应用一套图标」。

#include <windows.h>

#define IDI_APP_ICON 1

1 RT_MANIFEST "salary-tray.manifest"
IDI_APP_ICON ICON "resources/app_icon.ico"
